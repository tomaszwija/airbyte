{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "contactId": {
      "type": "integer"
    },
    "details": {
      "type": ["null", "object"],
      "properties": {
        "dnc": {
          "type": ["null", "object"],
          "properties": {
            "channel": {
              "type": ["null", "string"]
            },
            "channel_id": {
              "type": ["null", "integer"]
            },
            "comments": {
              "type": ["null", "string"]
            },
            "date_added": {
              "type": ["null", "string"],
              "format":"date-time"
            },
            "id": {
              "type": ["null", "integer"]
            },
            "itemName": {
              "type": ["null", "string"]
            },
            "itemRoute": {
              "type": ["null","string"]
            },
            "reason": {
              "type": ["null","string"]
            }  
          }
        }
      }
    },
    "event": {
      "type": ["null","string"]
    },
    "eventId": {
      "type": ["string"]
    },
    "eventLabel": {
      "type": ["null", "object"],
      "properties": {
        "href": {
          "type": ["null", "string"]
        },
        "label": {
          "type": ["null", "string"]
        }
      }
    },
    "eventType": {
      "type": ["null","string"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}